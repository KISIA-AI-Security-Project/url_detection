FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/opt/fast
WORKDIR /opt/l4
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir '.[aws,browser]' 'openai==3.22.1' 'boto3==1.43.106' 'pydantic==2.13.5'
COPY fast/evidence_pipeline /opt/fast/evidence_pipeline
COPY deployment/runtime-config.json /opt/l4/runtime-config.json
RUN python -c 'import l4_orchestrator.aws_runner; import l4_orchestrator.aws_start; import l4_orchestrator.aws_query; import evidence_pipeline.aws_fast_result'
ENTRYPOINT ["python", "-m", "l4_orchestrator.aws_runner"]
